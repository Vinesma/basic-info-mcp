{
  "name": "basic-info-mcp",
  "version": "1.0.0",
  "description": "A simple MCP server in TypeScript that gives AI tools access to basic information.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "link-service": "ln -sfv \"$(pwd)/systemd/basic-info-mcp.service\" \"$HOME/.config/systemd/user\""
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.16.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/jsdom": "^30.0.0",
    "dotenv": "^18.0.10",
    "jsdom": "^31.0.1",
    "undici": "^8.14.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
