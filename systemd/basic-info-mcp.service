[Unit]
Description=mcp server via Docker Compose
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/basic-info-mcp
EnvironmentFile=%h/Projects/basic-info-mcp/.env
ExecStart=/usr/bin/docker compose up --no-color --abort-on-container-exit
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target